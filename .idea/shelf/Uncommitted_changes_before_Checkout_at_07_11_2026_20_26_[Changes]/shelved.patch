+diff --git a/Searchoteca Web/frontend/src/main/resources/static/js/barcode.js b/Searchoteca Web/frontend/src/main/resources/static/js/barcode.js
+new file mode 100644
+index 0000000..b85e479
+--- /dev/null
++++ b/Searchoteca Web/frontend/src/main/resources/static/js/barcode.js	
+@@ -0,0 +1,17 @@
++/*
++ * Desenha o código de barras de cada <svg class="barcode" data-code="...">.
++ * Usa a biblioteca JsBarcode (Code 128, aceita letras e números).
++ * Sem internet o script não carrega, e a etiqueta continua mostrando o código em texto.
++ */
++(function () {
++    if (!window.JsBarcode) return;
++    document.querySelectorAll('svg.barcode[data-code]').forEach(function (svg) {
++        try {
++            JsBarcode(svg, svg.getAttribute('data-code'), {
++                format: 'CODE128', height: 46, width: 1.6, fontSize: 12, margin: 0, displayValue: true
++            });
++        } catch (e) {
++            svg.style.display = 'none';
++        }
++    });
++})();
+diff --git a/Searchoteca Web/frontend/src/main/resources/static/js/scanner.js b/Searchoteca Web/frontend/src/main/resources/static/js/scanner.js
+new file mode 100644
+index 0000000..8647c82
+--- /dev/null
++++ b/Searchoteca Web/frontend/src/main/resources/static/js/scanner.js	
+@@ -0,0 +1,25 @@
++/*
++ * Contador da leitura em lote: <textarea data-scan-count="idDoContador">.
++ * O leitor de código de barras USB digita o código e aperta Enter, então cada linha é um exemplar.
++ * Mostra quantos códigos foram lidos e avisa quando há repetidos.
++ */
++(function () {
++    document.querySelectorAll('textarea[data-scan-count]').forEach(function (area) {
++        var counter = document.getElementById(area.getAttribute('data-scan-count'));
++        if (!counter) return;
++        function update() {
++            var codes = area.value.split(/[\s,;]+/).filter(function (c) { return c.length > 0; });
++            var unique = new Set(codes);
++            var text = codes.length + (codes.length === 1 ? ' código lido' : ' códigos lidos');
++            if (unique.size !== codes.length) {
++                text += ' — ' + (codes.length - unique.size) + ' repetido(s)';
++                counter.classList.add('warn');
++            } else {
++                counter.classList.remove('warn');
++            }
++            counter.textContent = text;
++        }
++        area.addEventListener('input', update);
++        update();
++    });
++})();
+diff --git a/Searchoteca Web/frontend/src/main/resources/static/js/table-filter.js b/Searchoteca Web/frontend/src/main/resources/static/js/table-filter.js
+new file mode 100644
+index 0000000..9b7227f
+--- /dev/null
++++ b/Searchoteca Web/frontend/src/main/resources/static/js/table-filter.js	
+@@ -0,0 +1,22 @@
++/*
++ * Filtro das tabelas: <input data-filter-table="idDaTabela">.
++ * Esconde as linhas que não contêm o texto digitado (sem acento e sem diferenciar maiúsculas).
++ * As listagens do backend ainda não são paginadas, então o filtro é feito no navegador.
++ */
++(function () {
++    function normalize(text) {
++        return text.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
++    }
++
++    document.querySelectorAll('input[data-filter-table]').forEach(function (input) {
++        var table = document.getElementById(input.getAttribute('data-filter-table'));
++        if (!table) return;
++        input.disabled = false;
++        input.addEventListener('input', function () {
++            var term = normalize(input.value.trim());
++            table.querySelectorAll('tbody tr').forEach(function (row) {
++                row.style.display = normalize(row.textContent).indexOf(term) === -1 ? 'none' : '';
++            });
++        });
++    });
++})();
